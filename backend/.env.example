# ---------------------------------------------------------------------------
# Backend environment (copy to backend/.env for local dev; set the same keys in
# the Render dashboard for production)
# ---------------------------------------------------------------------------

# Gemini keys — comma-separated enables round-robin rotation across free quotas.
# Get them at https://aistudio.google.com/apikey
GEMINI_API_KEYS=key1,key2,key3
# Single-key fallback (used only when GEMINI_API_KEYS is empty)
# GEMINI_API_KEY=

# Model fallback chain: when the primary model is out of quota (free-tier
# 20 req/day), the next model is tried automatically. Comma-separated, no spaces.
# Leave empty to only use GEMINI_MODEL. Useful values: gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL_FALLBACKS=

# Which model to use first (change this to a model you have quota on).
GEMINI_MODEL=gemini-3.6-flash
# Neon dashboard -> Connect -> "Connection string" (use the -pooler host).
# Leave empty to run without a library; the app still generates ebooks.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# CORS: comma-separated frontend origins. `*` allows everything (fine locally).
ALLOWED_ORIGINS=*

# Page counting. true = render the PDF to measure exactly (accurate, slower,
# ~200MB extra RAM). false = fast estimate — recommended on small instances.
PAGE_VERIFY=true

# Scratch directory for intermediate PDFs (defaults to the system temp dir).
# PDF_OUTPUT_DIR=/tmp/ebook-writer

# Max pooled Postgres connections (Neon free tier is generous, 5 is plenty).
# DB_POOL_MAX=5
