# ---------------------------------------------------------------------------
# Frontend environment (copy to .env.local for local dev; on Render this is set
# automatically by render.yaml from the API service's host)
# ---------------------------------------------------------------------------

# Backend base URL. A bare hostname works too — the app adds https:// itself.
#   local:      http://127.0.0.1:8001   (8000 is often taken by other dev servers)
#   Render:     ebook-api.onrender.com
# NOTE: NEXT_PUBLIC_* values are baked in at BUILD time. Change it => restart dev
#       server / rebuild. This file's value is only a hint — your .env.local wins.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
